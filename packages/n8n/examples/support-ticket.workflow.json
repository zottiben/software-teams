        "schemaMode": "custom",
        "outputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"status\",\n    \"summary\",\n    \"question\",\n    \"classification\",\n    \"nextAction\",\n    \"customerReply\",\n    \"internalNotes\",\n    \"confidence\"\n  ],\n  \"properties\": {\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"ok\",\n        \"needs-input\",\n        \"error\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"question\": {\n      \"type\": \"string\"\n    },\n    \"classification\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"question\",\n        \"bug\",\n        \"change-request\",\n        \"escalation\"\n      ]\n    },\n    \"nextAction\": {\n      \"type\": \"string\"\n    },\n    \"customerReply\": {\n      \"type\": \"string\"\n    },\n    \"internalNotes\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    }\n  }\n}",
        "model": "sonnet",
        "effort": "",
        "fallbackModel": "haiku",
        "maxTurnBudgetUsd": 0,
        "maxTurns": 8,
        "resumeSession": true
      },
      "credentials": {
        "softwareTeamsApi": {
          "id": "REPLACE_WITH_CLAUDE_CREDENTIAL_ID",
          "name": "Software Teams API"
        }
      }
    },
